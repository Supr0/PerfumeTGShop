# Telegram bot token (from @BotFather). Never commit the real value.
BOT_TOKEN=
# Comma-separated Telegram user IDs with admin access.
ADMIN_IDS=12345678
# Async SQLAlchemy URL (matches docker-compose service name `db`).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/perfume

# --- docker-compose.prod.yml only (ignored by the app itself) ---
# Required by the production stack: password for the Postgres container.
# POSTGRES_PASSWORD=
# Published port for nginx (default 80).
# HTTP_PORT=80
# uvicorn worker count (default 2).
# WEB_CONCURRENCY=2
